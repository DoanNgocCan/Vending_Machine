# ==============================
# Smart Vending Machine - Env Template
# Copy this file to .env and fill real values
# ==============================

# Server/API
VENDING_SERVER_URL=https://your-vending-server.example.com
VENDING_DEVICE_ID=VENDING_MACHINE_01

# MQTT
MQTT_BROKER_HOST=your-mqtt-broker.example.com
MQTT_BROKER_PORT=443
MQTT_TOPIC_PRODUCT_UPDATE=vending_machine/product/update
MQTT_TOPIC_DATA_CHANGED=vending_machine/product/data_changed

# Local Flask payment service
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_PUBLIC_BASE_URL=http://localhost:5000
PAYMENT_API_URL=http://localhost:5000/create-payment-link

# PayOS credentials
PAYOS_CLIENT_ID=replace_with_payos_client_id
PAYOS_API_KEY=replace_with_payos_api_key
PAYOS_CHECKSUM_KEY=replace_with_payos_checksum_key
